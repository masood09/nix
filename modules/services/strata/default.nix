# Strata — local LLM inference server (OpenAI/Anthropic-compatible API).
#
# Upstream ships a generic-Linux terminal (bundled Python) and a HIP/CUDA
# engine (bundled ROCm/CUDA libraries) through a signed release feed. Nix owns
# the user, directories, FHS runtime, and unit lifecycle; the mutable runtime
# under stateDir is installed and updated by upstream's own signed tooling:
#
#   strata-install   oneshot; runs the official install.sh only when no
#                    terminal is installed (first boot / wiped state)
#   strata           ExecStartPre regenerates upstream's run config with
#                    `strata launch` when the Nix launch options or the
#                    installed terminal/engine versions change; ExecStart then
#                    runs the foreground `strata serve`
#   strata-update    optional daily timer; stops Strata, runs upstream's
#                    `strata update`, and starts Strata again (see below)
#
# Runtime size selection: `selectionFile` (written by a switcher such as
# model-router) names the size configure serves. Each size keeps its own
# run-config.<size>.json, .stamp and .managed-keys.json, and run-config.json
# links to the selected one. A stamp covers the launch options and the
# installed terminal and engine versions, so an update makes every size stale;
# the next start regenerates every stale size (others first, the selected one
# last) inside strata.service itself. Generation needs the RAM a running model
# holds, and a separate pre-generation unit raced the service's own start on
# 2026-11-17, so there is deliberately no such unit.
#
# Upstream's run config embeds version-specific paths, so it is generated by
# `strata launch` rather than templated here.
{
  config,
  lib,
  pkgs,
  ...
}: let
  homelabCfg = config.homelab;
  cfg = homelabCfg.services.strata;
  caddyEnabled = homelabCfg.services.caddy.enable;
  upstream = "${cfg.listenAddress}:${toString cfg.listenPort}";

  # OpenAI-style error body Caddy returns while Strata is stopped, restarting,
  # or still loading the model, instead of a bare 502.
  unavailableBody = builtins.toJSON {
    error = {
      type = "strata_unavailable";
      code = "backend_unavailable";
      message = "Local inference on ixian is temporarily unavailable (stopped, restarting, or loading the model). Retry shortly.";
    };
  };

  persistenceHelpers = import ../../../lib/persistence-helpers.nix {inherit lib;};
  systemdHelpers = import ../../../lib/systemd-helpers.nix {inherit lib pkgs;};
  permSvc = systemdHelpers.mkPermissionService {
    name = "strata";
    dataDir = cfg.stateDir;
    user = "strata";
    group = "strata";
    mode = "0750";
    mainServices = ["strata" "strata-install"];
  };

  strataBin = "${cfg.stateDir}/.local/bin/strata";
  # run-config.json is what `strata serve` and `strata update` read. It is a
  # symlink to the selected size's run-config.<size>.json, which in turn links
  # to the config upstream's launch generated for that size. Each size has its
  # own stamp and managed-keys file, so switching between generated sizes
  # costs one model load and no regeneration.
  runConfig = "${cfg.stateDir}/run-config.json";
  sizes = lib.unique ([cfg.model] ++ cfg.models);

  # The terminal's bundled Python and the engine need only glibc, the GCC
  # runtime libraries, and zlib from the host (engine SYSTEM-LIBS.txt). The
  # remaining packages are what install.sh shells out to. GPU access comes
  # from the host's /dev, /sys, and /run/opengl-driver, which bubblewrap
  # binds through. The PID namespace stays shared (the nixpkgs default) so
  # systemd's stop signal reaches the server and engine processes directly.
  strataFhs = pkgs.buildFHSEnv {
    name = "strata-fhs";
    targetPkgs = p:
      with p; [
        cacert
        curl
        libdrm
        pciutils
        stdenv.cc.cc.lib
        zlib
      ];
    runScript = pkgs.writeShellScript "strata-fhs-exec" ''
      exec "$@"
    '';
  };

  launchArgsFor = size:
    [
      "--family"
      cfg.family
      "--model"
      size
      "--context"
      cfg.context
      "--parallel"
      (toString cfg.parallel)
      "--vision"
      cfg.vision
      "--mtp"
      (
        if cfg.mtp
        then "on"
        else "off"
      )
      "--data-dir"
      cfg.dataDir
      "--access"
      "local"
      "--port"
      (toString cfg.listenPort)
      "--tune"
      "skip"
    ]
    ++ cfg.extraLaunchArgs;

  # Shell helpers shared by configure and generate.
  #   args_for SIZE   prints the escaped launch arguments for SIZE
  #   want_stamp SIZE prints the stamp SIZE's run config must carry: its launch
  #                   arguments plus the installed terminal and engine set,
  #                   because the generated config names version-specific
  #                   paths. A Strata update therefore makes every size stale.
  #   is_stale SIZE   succeeds when SIZE has no run config or an old stamp
  sizeHelpers = ''
    args_for() {
      case "$1" in
        ${lib.concatMapStringsSep "\n        " (s: "${lib.escapeShellArg s}) printf '%s' ${lib.escapeShellArg (lib.escapeShellArgs (launchArgsFor s))} ;;") sizes}
        *) echo "strata: unknown size $1" >&2; return 1 ;;
      esac
    }
    want_stamp() {
      local args terminal engines
      args="$(args_for "$1")"
      terminal="$(readlink -f ${cfg.stateDir}/.local/share/strata/terminal/current || true)"
      engines="$(ls ${cfg.stateDir}/.local/share/strata/components/engine 2>/dev/null || true)"
      printf '%s\n' "$args" "$terminal" "$engines" | ${pkgs.coreutils}/bin/sha256sum
    }
    is_stale() {
      [ ! -e "${cfg.stateDir}/run-config.$1.json" ] \
        || [ "$(cat "${cfg.stateDir}/run-config.$1.stamp" 2>/dev/null)" != "$(want_stamp "$1")" ]
    }
  '';

  # The size to serve: the selection file's, if it names a configured size.
  selectSize = ''
    size=${lib.escapeShellArg cfg.model}
    ${lib.optionalString (cfg.selectionFile != null) ''
      selected=""
      if [ -r ${lib.escapeShellArg cfg.selectionFile} ]; then
        selected="$(tr -d '[:space:]' < ${lib.escapeShellArg cfg.selectionFile})"
      fi
      case "$selected" in
        ${lib.concatMapStringsSep "|" lib.escapeShellArg sizes}) size="$selected" ;;
        "") ;;
        *) echo "strata: selection '$selected' is not a configured size; serving ${cfg.model}" >&2 ;;
      esac
    ''}
  '';

  strataEnv = {
    HOME = cfg.stateDir;
  };

  # Nix-owned top-level run-config keys, and the list of keys the last merge
  # wrote, so a key dropped from cfg.settings is also dropped from the file.
  settingsFile = pkgs.writeText "strata-settings.json" (builtins.toJSON cfg.settings);

  configure = pkgs.writeShellScript "strata-configure" ''
    set -euo pipefail
    jq=${pkgs.jq}/bin/jq
    ${sizeHelpers}
    ${selectSize}

    # Files of the single-size layout, superseded by the per-size ones.
    rm -f ${cfg.stateDir}/run-config.stamp ${cfg.stateDir}/run-config.managed-keys.json

    # Regenerate when the launch options, the terminal, or the engine set
    # change: the run config names version-specific terminal/engine paths.
    # With several sizes, every stale one is generated here, inside this
    # unit, so a later switch to any of them is one model load. Generation
    # needs the RAM a running model holds, which is why it happens in
    # Strata's own start rather than beside it. The selected size goes last.
    for s in ${lib.escapeShellArgs sizes}; do
      if [ "$s" != "$size" ] && is_stale "$s"; then
        ${generate} "$s"
      fi
    done
    if is_stale "$size"; then
      ${generate} "$size"
    fi

    sizeConfig=${cfg.stateDir}/run-config."$size".json
    managedKeys=${cfg.stateDir}/run-config."$size".managed-keys.json

    # Every start, after any regeneration (which rewrites the file): drop the
    # keys the previous merge wrote, then add the current ones. The stamp
    # leaves these out, so a settings change costs no extra model load.
    source="$(readlink -f "$sizeConfig")"
    old="$(cat "$managedKeys" 2>/dev/null || echo '[]')"
    tmp="$(mktemp "$source.XXXXXX")"
    "$jq" --argjson old "$old" --slurpfile new ${settingsFile} \
      'reduce $old[] as $k (.; del(.[$k])) + $new[0]' "$source" > "$tmp"
    mv "$tmp" "$source"
    "$jq" -c keys ${settingsFile} > "$managedKeys"

    # The experimental speed projection (a refusal-direction control vector;
    # see the experimentalSpeedProjection option). `strata launch` has no flag
    # for it, and its non-interactive setup always answers "off", so the
    # engine flags setup.py would write are owned here. They are stripped and
    # re-added on every start, in "args" (what serve runs) and in
    # "args_written"/"args_derived". Upstream treats options in "args" that are
    # missing from those copies as hand edits and carries them into the next
    # regeneration, so writing all three lets disabling the option really
    # remove them.
    esp='[]'
    ${lib.optionalString cfg.experimentalSpeedProjection ''
      vector="$("$jq" -r .cwd "$source")/data/experimental-speed-projection/Qwen3.8-Flash-Next-experimental-speed-projection.gguf"
      if [ ! -f "$vector" ]; then
        echo "strata: the experimental speed projection's vector is missing: $vector" >&2
        exit 1
      fi
      esp="$("$jq" -cn --arg v "$vector" \
        '["--control-vector-scaled", "\($v):1.0", "--control-vector-layer-range", "4", "44", "--cvec-mode", "project", "--cvec-dir", "per-layer"]')"
    ''}
    tmp="$(mktemp "$source.XXXXXX")"
    "$jq" --argjson esp "$esp" '
      def strip:
        . as $a
        | reduce range(0; $a | length) as $i ({out: [], skip: 0};
            if .skip > 0 then .skip -= 1
            elif $a[$i] == "--control-vector-layer-range" then .skip = 2
            elif ($a[$i] | IN("--control-vector-scaled", "--cvec-mode", "--cvec-dir")) then .skip = 1
            else .out += [$a[$i]]
            end)
        | .out;
      reduce ("args", "args_written", "args_derived") as $k (.;
        if has($k) then .[$k] = ((.[$k] | strip) + $esp) else . end)
    ' "$source" > "$tmp"
    mv "$tmp" "$source"

    # Serve the selected size: run-config.json is what ExecStart and the
    # update unit read.
    ln -sfn "run-config.$size.json" ${runConfig}
    echo "strata: serving $size"
  '';

  # generate SIZE: run upstream's launch for SIZE to write its run config.
  generate = pkgs.writeShellScript "strata-generate" ''
    set -euo pipefail
    ${sizeHelpers}
    size="$1"
    args="$(args_for "$size")"
    strata() {
      ${strataFhs}/bin/strata-fhs ${strataBin} "$@"
    }
    # args is the output of lib.escapeShellArgs, so eval only splits it.
    eval "set -- $args"

    echo "strata: generating the $size run config: strata launch $args"
    profile="$(strata launch "$@" --plan --output json | ${pkgs.jq}/bin/jq -r .plan.profile)"

    # `launch` has no write-config-only mode, so it does a full start (one
    # model load), and the owned runtime is stopped before ExecStart serves.
    strata launch "$@" --no-tui --yes --restart
    strata runtime stop --profile "$profile"

    source="$(${pkgs.jq}/bin/jq -r .source_config ${cfg.stateDir}/.config/strata/profiles/"$profile".json)"
    ln -sfn "$source" ${cfg.stateDir}/run-config."$size".json

    # Launch wrote the engine version actually used, so stamp after it.
    want_stamp "$size" > ${cfg.stateDir}/run-config."$size".stamp
  '';

  # Daily update. Upstream's `strata update` refuses to replace an engine that
  # is serving (exit 7; --yes alone never stops a model), so the unit stops
  # strata.service around it:
  #   ExecCondition    skip while holdFile exists (the test start needs the GPU)
  #   ExecCondition    skip unless the feed offers a newer engine or Control
  #   ExecStartPre=+   remember whether Strata was running, then stop it
  #   ExecStart        `strata update`: a new engine is staged and switched to
  #                    only after a full test start of the model passes, so a
  #                    failed test leaves the old engine in place; a new
  #                    Control is checked only with `--version`
  #   ExecStopPost=+   start Strata again if it was running; runs on failure
  #                    too, so a failed update still restores the service
  # Only the two systemctl scripts need root (+). ExecCondition exit codes are
  # load-bearing: 1 skips the run cleanly ("up to date"), 255 marks the unit
  # failed, so only a broken feed or CLI shows in `systemctl --failed`.
  #
  # `update --check` is not a pure read: upstream records the accepted feed
  # sequence and last_check in .updates/state.json, so each daily run advances
  # the feed's downgrade guard, and a later manual `strata-ctl update --check`
  # reports against that state.
  #
  # The was-running flag lives in RuntimeDirectory, named from one value so the
  # root (+) scripts do not depend on $RUNTIME_DIRECTORY being set for them.
  updateRunDirName = "strata-update";
  updateWasRunning = "/run/${updateRunDirName}/was-running";

  # ExecCondition for holdFile: exit 1 skips the start cleanly (a skip is not a
  # failure, so Restart= does not retry it). Empty without a hold.
  holdCheck = lib.optional (cfg.holdFile != null) (pkgs.writeShellScript "strata-hold-check" ''
    if [ -e ${lib.escapeShellArg cfg.holdFile} ]; then
      echo "Strata is held (${cfg.holdFile} exists): not starting"
      exit 1
    fi
  '');

  updateCheck = pkgs.writeShellScript "strata-update-check" ''
    set -euo pipefail
    jq=${pkgs.jq}/bin/jq
    if ! plan="$(${strataFhs}/bin/strata-fhs ${strataBin} update --check --json --quiet)"; then
      echo "reading the Strata update feed failed" >&2
      exit 255
    fi
    # A malformed answer must fail the unit, not read as "up to date".
    # "install" is an engine folder with no engine in it (wiped components);
    # the update installs one, which strata-install (keyed on the terminal)
    # would not.
    if ! decision="$("$jq" -er 'if (.engine.status | type) == "string" and (.control.status | type) == "string"
        then (if (.engine.status | IN("available", "install")) or .control.status == "available" then "update" else "current" end)
        else error("no engine/control status") end' <<<"$plan")"; then
      echo "the Strata update feed answered with something unexpected" >&2
      exit 255
    fi
    if [ "$decision" = update ]; then
      "$jq" -r '"Strata update: engine \(.engine.installed.version // "?") -> \(.engine.offered.version // "-") (\(.engine.status)), Control \(.control.installed // "?") -> \(.control.offered // "-") (\(.control.status))"' <<<"$plan"
      exit 0
    fi
    echo "Strata is up to date"
    exit 1
  '';

  updatePrepare = pkgs.writeShellScript "strata-update-prepare" ''
    set -euo pipefail
    flag=${updateWasRunning}
    rm -f "$flag"
    if ${pkgs.systemd}/bin/systemctl is-active -q strata.service; then
      touch "$flag"
      echo "stopping Strata for the update"
      ${pkgs.systemd}/bin/systemctl stop strata.service
    fi
  '';

  updateRestore = pkgs.writeShellScript "strata-update-restore" ''
    flag=${updateWasRunning}
    if [ ! -e "$flag" ]; then
      exit 0
    fi
    rm -f "$flag"
    echo "starting Strata again (service result: ''${SERVICE_RESULT:-unknown})"
    ${pkgs.systemd}/bin/systemctl start --no-block strata.service
  '';

  # Manual CLI: runs upstream's `strata` as the strata user inside the FHS
  # env, e.g. `strata-ctl status`, `strata-ctl update --check`,
  # `strata-ctl components rollback`.
  strataCtl = pkgs.writeShellScriptBin "strata-ctl" ''
    if [ "$(id -u)" != ${toString cfg.userId} ]; then
      exec sudo -u strata -H -- "$0" "$@"
    fi
    cd ${cfg.stateDir}
    exec ${strataFhs}/bin/strata-fhs ${strataBin} "$@"
  '';
in {
  imports = [
    ./options.nix
  ];

  config = lib.mkIf cfg.enable {
    assertions = [
      {
        # Sizes become file names and shell `case` patterns.
        assertion = lib.all (s: builtins.match "[A-Za-z0-9][A-Za-z0-9._-]*" s != null) sizes;
        message = "homelab.services.strata.model/models entries must be plain size names (letters, digits, '.', '_', '-'), got: ${lib.concatStringsSep ", " sizes}.";
      }
      {
        assertion = !cfg.experimentalSpeedProjection || lib.elem cfg.family ["qwen" "coder"];
        message = "homelab.services.strata.experimentalSpeedProjection is made for the original Qwen3.8-Flash-Next: upstream only applies it to the qwen and coder families, not ${cfg.family}.";
      }
    ];

    users = {
      users = {
        strata = {
          isSystemUser = true;
          group = "strata";
          uid = cfg.userId;
          home = cfg.stateDir;
          createHome = false;
          extraGroups = [
            "render"
            "video"
          ];
        };
      };

      groups = {
        strata = {
          gid = cfg.groupId;
        };
      };
    };

    environment = lib.mkMerge [
      {
        systemPackages = [
          strataCtl
        ];
      }
      (persistenceHelpers.mkPersistenceDirs {
        inherit homelabCfg;
        directories = [
          {
            directory = cfg.stateDir;
            user = "strata";
            group = "strata";
            mode = "0750";
          }
        ];
      })
    ];

    services = {
      caddy = lib.mkIf caddyEnabled {
        virtualHosts = {
          "${cfg.webDomain}" = {
            useACMEHost = config.networking.domain;
            # Strata rejects any Host other than its own (DNS-rebinding
            # protection) and browser Origins it doesn't know. Present the
            # upstream address for both; the Origin is rewritten only for this
            # site's own pages, so other web pages still can't drive the API
            # through a visitor's browser.
            extraConfig = ''
              @selfOrigin header Origin https://${cfg.webDomain}
              request_header @selfOrigin Origin http://${upstream}

              reverse_proxy http://${upstream} {
                header_up Host {upstream_hostport}
                # Stream tokens as they are generated.
                flush_interval -1
              }

              # Only errors Caddy itself raises (upstream refused or timed
              # out) land here; Strata's own error responses pass through.
              # Already-open streams are cut when Strata stops.
              handle_errors 502 503 504 {
                header Content-Type application/json
                header Retry-After 30
                respond `${unavailableBody}` 503
              }
            '';
          };
        };
      };
    };

    systemd = lib.mkMerge [
      permSvc.systemd
      {
        services = {
          # The model tree predates the service user, so hand it over once.
          # Later boots only scan metadata; chown runs only on a mismatch.
          strata-data-permissions = {
            description = "Hand Strata model storage to the strata user";
            before = [
              "strata.service"
            ];
            unitConfig = {
              RequiresMountsFor = [
                cfg.dataDir
              ];
            };
            serviceConfig = {
              Type = "oneshot";
              RemainAfterExit = true;
            };
            script = ''
              install -d -m 0750 -o strata -g strata ${cfg.dataDir}
              if [ "$(stat -c %U ${cfg.dataDir})" != strata ] \
                || [ -n "$(find ${cfg.dataDir} ! -user strata -print -quit)" ]; then
                chown -R strata:strata ${cfg.dataDir}
              fi
              chmod 0750 ${cfg.dataDir}
            '';
          };

          strata-install = {
            description = "Install the Strata terminal from the signed upstream release";
            before = [
              "strata.service"
            ];
            after = [
              "network-online.target"
            ];
            wants = [
              "network-online.target"
            ];
            unitConfig = {
              ConditionPathExists = "!${strataBin}";
            };
            environment = strataEnv;
            path = [
              pkgs.coreutils
              pkgs.curl
            ];
            serviceConfig = {
              Type = "oneshot";
              RemainAfterExit = true;
              User = "strata";
              Group = "strata";
              WorkingDirectory = cfg.stateDir;
            };
            # install.sh checks the terminal archive's SHA-256 against the
            # release manifest and verifies the signed feed with the unpacked
            # terminal before switching `current`.
            script = ''
              work="$(mktemp -d)"
              trap 'rm -rf "$work"' EXIT
              curl -fsSL --retry 3 \
                https://github.com/Niko1221/Strata/releases/latest/download/install.sh \
                -o "$work/install.sh"
              ${strataFhs}/bin/strata-fhs sh "$work/install.sh"
            '';
          };

          strata = {
            description = "Strata local LLM inference server";
            wantedBy = [
              "multi-user.target"
            ];
            after = [
              "network-online.target"
              "strata-install.service"
              "strata-data-permissions.service"
            ];
            wants = [
              "network-online.target"
            ];
            requires = [
              "strata-install.service"
              "strata-data-permissions.service"
            ];
            unitConfig = {
              RequiresMountsFor = [
                cfg.dataDir
              ];
            };
            environment = strataEnv;
            serviceConfig = {
              User = "strata";
              Group = "strata";
              SupplementaryGroups = [
                "render"
                "video"
              ];
              WorkingDirectory = cfg.stateDir;
              RuntimeDirectory = "strata";

              ExecCondition = holdCheck;
              ExecStartPre = configure;
              ExecStart = lib.concatStringsSep " " [
                "${strataFhs}/bin/strata-fhs"
                strataBin
                "serve"
                "--config ${runConfig}"
                "--host ${cfg.listenAddress}"
                "--port ${toString cfg.listenPort}"
                "--parallel ${toString cfg.parallel}"
                "--ready-file /run/strata/ready.json"
                "--shutdown-timeout 30"
              ];

              Restart = "on-failure";
              RestartSec = 30;
              # A warm start is 1–3 minutes; a cold first start (engine
              # download, model page-in) was measured at ~16 minutes, and each
              # config regeneration adds one extra model load: one per stale
              # size, so allow 30 more minutes per extra size.
              TimeoutStartSec = "${toString (45 + 30 * (builtins.length sizes - 1))}min";
              # Server drain (--shutdown-timeout) plus engine teardown.
              TimeoutStopSec = 90;

              # Conservative hardening only. Not set: PrivateDevices (HIP needs
              # /dev/kfd and /dev/dri), MemoryDenyWriteExecute (GPU JIT),
              # ProtectKernelTunables (engine reads sysfs), and namespace
              # restrictions (bubblewrap needs a user/mount namespace).
              NoNewPrivileges = true;
              PrivateTmp = true;
              ProtectHome = "tmpfs";
              ProtectSystem = "full";
            };
          };

          strata-update = lib.mkIf cfg.autoUpdate.enable {
            description = "Install upstream Strata engine and Control updates";
            after = [
              "network-online.target"
              "strata-install.service"
              "strata-data-permissions.service"
            ];
            wants = [
              "network-online.target"
            ];
            unitConfig = {
              ConditionPathExists = strataBin;
              RequiresMountsFor = [
                cfg.dataDir
              ];
            };
            environment = strataEnv;
            serviceConfig = {
              Type = "oneshot";
              User = "strata";
              Group = "strata";
              # The test start loads the model on the GPU.
              SupplementaryGroups = [
                "render"
                "video"
              ];
              WorkingDirectory = cfg.stateDir;
              RuntimeDirectory = updateRunDirName;

              # The hold check runs first, so a held day never reads the feed.
              ExecCondition = holdCheck ++ [updateCheck];
              ExecStartPre = "+${updatePrepare}";
              ExecStart = "${strataFhs}/bin/strata-fhs ${strataBin} update --yes --model-config ${runConfig}";
              ExecStopPost = "+${updateRestore}";

              # ~770 MB of downloads plus one test start (upstream allows
              # 600 s). A cold page-in of this model was measured at ~16 min,
              # so match strata.service.
              TimeoutStartSec = "45min";

              # Same reasoning as strata.service.
              NoNewPrivileges = true;
              PrivateTmp = true;
              ProtectHome = "tmpfs";
              ProtectSystem = "full";
            };
          };
        };

        timers = {
          strata-update = lib.mkIf cfg.autoUpdate.enable {
            description = "Daily Strata update check";
            wantedBy = [
              "timers.target"
            ];
            timerConfig = {
              OnCalendar = cfg.autoUpdate.schedule;
              RandomizedDelaySec = "15min";
              # No catch-up at boot: it would stop Strata right after boot
              # started it.
              Persistent = false;
            };
          };
        };
      }
    ];
  };
}
