# Strata — local LLM inference server (OpenAI/Anthropic-compatible API).
#
# Upstream ships a generic-Linux terminal (bundled Python) and a HIP/CUDA
# engine (bundled ROCm/CUDA libraries) through a signed release feed. Nix owns
# the user, directories, FHS runtime, and unit lifecycle; the mutable runtime
# under stateDir is installed and updated by upstream's own signed tooling:
#
#   strata-install   oneshot; runs the official install.sh only when no
#                    terminal is installed (first boot / wiped state)
#   strata           ExecStartPre regenerates upstream's run config with
#                    `strata launch` when the Nix launch options or the
#                    installed terminal/engine versions change; ExecStart then
#                    runs the foreground `strata serve`
#
# Upstream's run config embeds version-specific paths, so it is generated by
# `strata launch` rather than templated here.
#
# With homelab.services.strata.tvGuard.enable, the TV guard owns the service's
# lifecycle: strata.service gets no [Install] section, so boot (which starts
# what a target wants) and a switch (which restarts the active targets and
# otherwise only touches units that are already active) cannot load the model
# while the TV is using the GPU. See the guard below.
{
  config,
  lib,
  pkgs,
  ...
}: let
  homelabCfg = config.homelab;
  cfg = homelabCfg.services.strata;
  caddyEnabled = homelabCfg.services.caddy.enable;
  upstream = "${cfg.listenAddress}:${toString cfg.listenPort}";

  # OpenAI-style error body Caddy returns while Strata is stopped, restarting,
  # or still loading the model, instead of a bare 502.
  unavailableBody = builtins.toJSON {
    error = {
      type = "strata_unavailable";
      code = "backend_unavailable";
      message = "Local inference on ixian is temporarily unavailable (stopped, restarting, or loading the model). Retry shortly.";
    };
  };

  persistenceHelpers = import ../../../lib/persistence-helpers.nix {inherit lib;};
  systemdHelpers = import ../../../lib/systemd-helpers.nix {inherit lib pkgs;};
  permSvc = systemdHelpers.mkPermissionService {
    name = "strata";
    dataDir = cfg.stateDir;
    user = "strata";
    group = "strata";
    mode = "0750";
    mainServices = ["strata" "strata-install"];
  };

  strataBin = "${cfg.stateDir}/.local/bin/strata";
  runConfig = "${cfg.stateDir}/run-config.json";
  configStamp = "${cfg.stateDir}/run-config.stamp";

  # The terminal's bundled Python and the engine need only glibc, the GCC
  # runtime libraries, and zlib from the host (engine SYSTEM-LIBS.txt). The
  # remaining packages are what install.sh shells out to. GPU access comes
  # from the host's /dev, /sys, and /run/opengl-driver, which bubblewrap
  # binds through. The PID namespace stays shared (the nixpkgs default) so
  # systemd's stop signal reaches the server and engine processes directly.
  strataFhs = pkgs.buildFHSEnv {
    name = "strata-fhs";
    targetPkgs = p:
      with p; [
        cacert
        curl
        libdrm
        pciutils
        stdenv.cc.cc.lib
        zlib
      ];
    runScript = pkgs.writeShellScript "strata-fhs-exec" ''
      exec "$@"
    '';
  };

  launchArgs =
    [
      "--family"
      cfg.family
      "--model"
      cfg.model
      "--context"
      cfg.context
      "--parallel"
      (toString cfg.parallel)
      "--vision"
      cfg.vision
      "--mtp"
      (
        if cfg.mtp
        then "on"
        else "off"
      )
      "--data-dir"
      cfg.dataDir
      "--access"
      "local"
      "--port"
      (toString cfg.listenPort)
      "--tune"
      "skip"
    ]
    ++ cfg.extraLaunchArgs;
  launchArgsStr = lib.escapeShellArgs launchArgs;

  strataEnv = {
    HOME = cfg.stateDir;
  };

  configure = pkgs.writeShellScript "strata-configure" ''
    set -euo pipefail
    strata() {
      ${strataFhs}/bin/strata-fhs ${strataBin} "$@"
    }

    # Regenerate when the launch options, the terminal, or the engine set
    # change: the run config names version-specific terminal/engine paths.
    terminal="$(readlink -f ${cfg.stateDir}/.local/share/strata/terminal/current || true)"
    engines="$(ls ${cfg.stateDir}/.local/share/strata/components/engine 2>/dev/null || true)"
    want="$(printf '%s\n' ${lib.escapeShellArg launchArgsStr} "$terminal" "$engines" | ${pkgs.coreutils}/bin/sha256sum)"

    if [ -e ${runConfig} ] && [ "$(cat ${configStamp} 2>/dev/null)" = "$want" ]; then
      exit 0
    fi

    echo "strata: generating run config: strata launch ${launchArgsStr}"
    profile="$(strata launch ${launchArgsStr} --plan --output json | ${pkgs.jq}/bin/jq -r .plan.profile)"

    # `launch` has no write-config-only mode, so it does a full start (one
    # model load), and the owned runtime is stopped before ExecStart serves.
    strata launch ${launchArgsStr} --no-tui --yes --restart
    strata runtime stop --profile "$profile"

    source="$(${pkgs.jq}/bin/jq -r .source_config ${cfg.stateDir}/.config/strata/profiles/"$profile".json)"
    ln -sfn "$source" ${runConfig}

    # Launch wrote the engine version actually used, so stamp after it.
    terminal="$(readlink -f ${cfg.stateDir}/.local/share/strata/terminal/current || true)"
    engines="$(ls ${cfg.stateDir}/.local/share/strata/components/engine 2>/dev/null || true)"
    printf '%s\n' ${lib.escapeShellArg launchArgsStr} "$terminal" "$engines" | ${pkgs.coreutils}/bin/sha256sum > ${configStamp}
  '';

  # Manual CLI: runs upstream's `strata` as the strata user inside the FHS
  # env, e.g. `strata-ctl status`, `strata-ctl update --check`,
  # `strata-ctl components rollback`.
  strataCtl = pkgs.writeShellScriptBin "strata-ctl" ''
    if [ "$(id -u)" != ${toString cfg.userId} ]; then
      exec sudo -u strata -H -- "$0" "$@"
    fi
    cd ${cfg.stateDir}
    exec ${strataFhs}/bin/strata-fhs ${strataBin} "$@"
  '';

  # Polls the TV over network ADB. The TV leaves the network entirely in
  # standby, so only a reachable, `mWakefulness=Awake` TV counts as on;
  # unreachable means off (or unplugged). adb keeps a dead transport as
  # "already connected" after the TV drops off, so every check reconnects.
  tvGuardStateDir = "/var/lib/strata-tv-guard";
  tvGuard = pkgs.writeShellApplication {
    name = "strata-tv-guard";
    runtimeInputs = [
      pkgs.android-tools
      pkgs.coreutils
      pkgs.gnugrep
      pkgs.systemd
    ];
    text = ''
      tv=${lib.escapeShellArg cfg.tvGuard.address}
      # The guard's state lives in its RuntimeDirectory. Boot wipes /run, so
      # every boot starts with no claim on Strata, which is what lets the guard
      # start Strata after the TV has been off for offDelay.
      # RuntimeDirectoryPreserve=yes keeps it across a stop and a start of the
      # guard: NixOS stops a changed service (stopIfChanged defaults to true)
      # instead of restarting it, and `restart` only covers Restart= and
      # `systemctl restart`. `yes` covers a switch, and still cannot outlive a
      # reboot.
      #   tv-on            - the last poll saw the TV awake
      #   tv-off-since     - exists while the TV has been off; its mtime is when
      #                      the off period began
      #   started-by-guard - the guard asked for Strata, or is watching a Strata
      #                      it did not start, and has not seen it come down
      #   held-by-guard    - do not start Strata: it came down without the guard
      #                      asking for it
      #
      # Start/stop rules:
      # - TV awake: hold Strata and stop it if it is running.
      # - TV off for offDelay: start Strata, except while a marker says the guard
      #   already started it or that it is being held.
      # - A manual `systemctl stop strata` looks exactly like the guard's own
      #   stop: the unit the guard last started is no longer running. The guard
      #   records that as a hold, so the manual stop is respected until the next
      #   TV on -> off cycle (that edge drops the hold, because a fresh cycle may
      #   start Strata again) or until a manual `systemctl start strata`, which
      #   the guard reads as a request to watch Strata again.
      # - A manual `systemctl start strata` while the TV is awake is allowed, but
      #   the TV-on rule stops it on the next poll.
      # - Strata running without a marker (the guard came up after a boot, or
      #   lost its state, and something else started Strata) is adopted, so a
      #   stop of it is treated as a manual one.
      marker_tv_on=/run/strata-tv-guard/tv-on
      marker_off=/run/strata-tv-guard/tv-off-since
      marker_started=/run/strata-tv-guard/started-by-guard
      marker_held=/run/strata-tv-guard/held-by-guard
      warned_unauthorized=""
      # Consecutive polls that saw a guard-started Strata not running, which is
      # how a guard stop is told apart from a manual one. See below.
      misses=0

      tv_on() {
        adb disconnect "$tv" >/dev/null 2>&1 || true
        timeout 3 adb connect "$tv" >/dev/null 2>&1 || return 1
        if adb devices | grep -q "^''${tv}[[:space:]]*unauthorized"; then
          if [ -z "$warned_unauthorized" ]; then
            echo "TV has not authorized this host's ADB key; accept the prompt on the TV" >&2
            warned_unauthorized=1
          fi
          return 1
        fi
        warned_unauthorized=""
        timeout 5 adb -s "$tv" shell dumpsys power 2>/dev/null | grep -q "mWakefulness=Awake"
      }

      while true; do
        # One unit read per poll: ActiveState answers both "is Strata up?" and
        # "did systemd give up on it?".
        unit_state="$(systemctl show -p ActiveState --value strata.service)"
        running=""
        case "$unit_state" in
          active | activating | reloading) running=1 ;;
        esac

        if tv_on; then
          # TV awake: Strata must not hold RAM or VRAM.
          rm -f "$marker_off" "$marker_started"
          touch "$marker_tv_on"
          # started-by-guard is gone, so the miss count that reads it is void.
          misses=0
          if [ -n "$running" ]; then
            echo "TV is on: stopping Strata"
            systemctl stop strata.service || echo "stopping Strata failed" >&2
          fi
        else
          if [ -e "$marker_tv_on" ]; then
            # on -> off edge: the cycle a hold waits for is over, so a hold from
            # a stop is dropped and the off period starts counting here.
            rm -f "$marker_tv_on" "$marker_held"
            touch "$marker_off"
          elif [ ! -e "$marker_off" ]; then
            # First poll after a boot, or after a guard restart, with the TV
            # already off and no record of it being awake: start the off period
            # here. After a boot there are no markers at all, which is what lets
            # the guard make the first start.
            touch "$marker_off"
          fi

          now=$(date +%s)
          off_since=$(stat -c %Y "$marker_off")

          if [ -e "$marker_started" ]; then
            if [ -n "$running" ]; then
              misses=0
            else
              misses=$((misses + 1))
            fi

            # A unit the guard started that is no longer running came down
            # without the guard asking for it: stopped by a person, or failed for
            # good. Honour that as a hold instead of fighting it every poll.
            #
            # A queued start job is not visible in ActiveState (it is a Job
            # property, not a Unit property), so a single poll can read "not
            # running" while the guard's own start is still coming up. Require
            # two consecutive such polls - about 20 s at interval=10 - before
            # concluding Strata came down on its own.
            if [ "$misses" -ge 2 ]; then
              echo "Strata came down without the guard asking (ActiveState=''${unit_state}); holding it until the TV cycles on and off" >&2
              rm -f "$marker_started"
              touch "$marker_held"
            fi
          elif [ -e "$marker_held" ]; then
            if [ -n "$running" ]; then
              # Started by hand while held: take that as a request to run Strata
              # and go back to watching it.
              echo "Strata started by hand while held: watching it again"
              rm -f "$marker_held"
              touch "$marker_started"
            fi
          elif [ -n "$running" ]; then
            # Running with no marker: started by hand, or already up when the
            # guard came up (the first deploy of this change, or a switch that
            # lost the RuntimeDirectory). Adopt it, so a later stop of this unit
            # is recognised as a manual one instead of being undone offDelay
            # later. Left alone until the TV is awake, where the TV-on rule
            # stops it.
            echo "Strata is running without the guard having started it: watching it"
            touch "$marker_started"
            misses=0
          elif [ $((now - off_since)) -ge ${toString cfg.tvGuard.offDelay} ]; then
            # reset-failed first: a unit left in `failed` by a start limit
            # refuses `start` until its counters are cleared.
            systemctl reset-failed strata.service || true
            echo "TV off for ${toString cfg.tvGuard.offDelay}s: starting Strata"
            systemctl start --no-block strata.service
            touch "$marker_started"
            misses=0
          fi
        fi
        sleep ${toString cfg.tvGuard.interval}
      done
    '';
  };
in {
  imports = [
    ./options.nix
  ];

  config = lib.mkIf cfg.enable {
    users = {
      users = {
        strata = {
          isSystemUser = true;
          group = "strata";
          uid = cfg.userId;
          home = cfg.stateDir;
          createHome = false;
          extraGroups = [
            "render"
            "video"
          ];
        };
      };

      groups = {
        strata = {
          gid = cfg.groupId;
        };
      };
    };

    environment = lib.mkMerge [
      {
        systemPackages = [
          strataCtl
        ];
      }
      (persistenceHelpers.mkPersistenceDirs {
        inherit homelabCfg;
        directories =
          [
            {
              directory = cfg.stateDir;
              user = "strata";
              group = "strata";
              mode = "0750";
            }
          ]
          # The guard's ADB key; losing it means re-authorizing on the TV.
          ++ lib.optionals cfg.tvGuard.enable [
            {
              directory = tvGuardStateDir;
              mode = "0700";
            }
          ];
      })
    ];

    services = {
      caddy = lib.mkIf caddyEnabled {
        virtualHosts = {
          "${cfg.webDomain}" = {
            useACMEHost = config.networking.domain;
            # Strata rejects any Host other than its own (DNS-rebinding
            # protection) and browser Origins it doesn't know. Present the
            # upstream address for both; the Origin is rewritten only for this
            # site's own pages, so other web pages still can't drive the API
            # through a visitor's browser.
            extraConfig = ''
              @selfOrigin header Origin https://${cfg.webDomain}
              request_header @selfOrigin Origin http://${upstream}

              reverse_proxy http://${upstream} {
                header_up Host {upstream_hostport}
                # Stream tokens as they are generated.
                flush_interval -1
              }

              # Only errors Caddy itself raises (upstream refused or timed
              # out) land here; Strata's own error responses pass through.
              # Already-open streams are cut when Strata stops.
              handle_errors 502 503 504 {
                header Content-Type application/json
                header Retry-After 30
                respond `${unavailableBody}` 503
              }
            '';
          };
        };
      };
    };

    systemd = lib.mkMerge [
      permSvc.systemd
      {
        services = {
          # The model tree predates the service user, so hand it over once.
          # Later boots only scan metadata; chown runs only on a mismatch.
          strata-data-permissions = {
            description = "Hand Strata model storage to the strata user";
            before = [
              "strata.service"
            ];
            unitConfig = {
              RequiresMountsFor = [
                cfg.dataDir
              ];
            };
            serviceConfig = {
              Type = "oneshot";
              RemainAfterExit = true;
            };
            script = ''
              install -d -m 0750 -o strata -g strata ${cfg.dataDir}
              if [ "$(stat -c %U ${cfg.dataDir})" != strata ] \
                || [ -n "$(find ${cfg.dataDir} ! -user strata -print -quit)" ]; then
                chown -R strata:strata ${cfg.dataDir}
              fi
              chmod 0750 ${cfg.dataDir}
            '';
          };

          strata-install = {
            description = "Install the Strata terminal from the signed upstream release";
            before = [
              "strata.service"
            ];
            after = [
              "network-online.target"
            ];
            wants = [
              "network-online.target"
            ];
            unitConfig = {
              ConditionPathExists = "!${strataBin}";
            };
            environment = strataEnv;
            path = [
              pkgs.coreutils
              pkgs.curl
            ];
            serviceConfig = {
              Type = "oneshot";
              RemainAfterExit = true;
              User = "strata";
              Group = "strata";
              WorkingDirectory = cfg.stateDir;
            };
            # install.sh checks the terminal archive's SHA-256 against the
            # release manifest and verifies the signed feed with the unpacked
            # terminal before switching `current`.
            script = ''
              work="$(mktemp -d)"
              trap 'rm -rf "$work"' EXIT
              curl -fsSL --retry 3 \
                https://github.com/Niko1221/Strata/releases/latest/download/install.sh \
                -o "$work/install.sh"
              ${strataFhs}/bin/strata-fhs sh "$work/install.sh"
            '';
          };

          strata = {
            description = "Strata local LLM inference server";
            # With the guard enabled, the guard is the only thing that starts
            # Strata. Boot starts what a target wants and a switch re-starts the
            # active targets, so with no wantedBy there is no path to starting
            # this unit; either path would load ~40 GB of experts into RAM and
            # ~15 GB into VRAM while the TV has the GPU. That contention is what
            # crashed gamescope on 2026-11-03. The guard starts Strata once the
            # TV has been off for tvGuard.offDelay.
            wantedBy = lib.optionals (!cfg.tvGuard.enable) [
              "multi-user.target"
            ];
            after = [
              "network-online.target"
              "strata-install.service"
              "strata-data-permissions.service"
            ];
            wants = [
              "network-online.target"
            ];
            requires = [
              "strata-install.service"
              "strata-data-permissions.service"
            ];
            unitConfig = {
              RequiresMountsFor = [
                cfg.dataDir
              ];
            };
            environment = strataEnv;
            serviceConfig = {
              User = "strata";
              Group = "strata";
              SupplementaryGroups = [
                "render"
                "video"
              ];
              WorkingDirectory = cfg.stateDir;
              RuntimeDirectory = "strata";

              ExecStartPre = configure;
              ExecStart = lib.concatStringsSep " " [
                "${strataFhs}/bin/strata-fhs"
                strataBin
                "serve"
                "--config ${runConfig}"
                "--host ${cfg.listenAddress}"
                "--port ${toString cfg.listenPort}"
                "--parallel ${toString cfg.parallel}"
                "--ready-file /run/strata/ready.json"
                "--shutdown-timeout 30"
              ];

              Restart = "on-failure";
              RestartSec = 30;
              # A warm start is 1–3 minutes; a cold first start (engine
              # download, model page-in) was measured at ~16 minutes, and a
              # config regeneration adds one extra model load.
              TimeoutStartSec = "45min";
              # Server drain (--shutdown-timeout) plus engine teardown.
              TimeoutStopSec = 90;

              # Conservative hardening only. Not set: PrivateDevices (HIP needs
              # /dev/kfd and /dev/dri), MemoryDenyWriteExecute (GPU JIT),
              # ProtectKernelTunables (engine reads sysfs), and namespace
              # restrictions (bubblewrap needs a user/mount namespace).
              NoNewPrivileges = true;
              PrivateTmp = true;
              ProtectHome = "tmpfs";
              ProtectSystem = "full";
            };
          };

          strata-tv-guard = lib.mkIf cfg.tvGuard.enable {
            description = "Start and stop Strata around the living-room TV";
            # Wanted by multi-user.target on purpose: with wantedBy dropped from
            # strata.service, this unit is the only thing that can start it, so
            # it must come up at boot. The oneshots strata.service `requires`
            # (strata-install, strata-data-permissions) are RemainAfterExit and
            # are still pulled in by each guard-started activation.
            wantedBy = [
              "multi-user.target"
            ];
            after = [
              "network-online.target"
            ];
            wants = [
              "network-online.target"
            ];
            # adb keeps its key in $HOME/.android.
            environment = {
              HOME = tvGuardStateDir;
            };
            serviceConfig = {
              # Root only to stop and start strata.service.
              ExecStart = lib.getExe tvGuard;
              StateDirectory = "strata-tv-guard";
              StateDirectoryMode = "0700";
              RuntimeDirectory = "strata-tv-guard";
              # The markers must outlive a stop and a start of this unit, or a
              # hold that is respecting a manual stop would be forgotten and
              # Strata would come back. A switch stops a changed service
              # (stopIfChanged defaults to true), and Preserve=restart only
              # covers Restart= and `systemctl restart`, so use yes. Boot still
              # wipes /run, which is what keeps a reboot startable.
              RuntimeDirectoryPreserve = "yes";
              Restart = "always";
              RestartSec = 10;
              # Stopping Strata drains for up to TimeoutStopSec (90 s).
              TimeoutStopSec = 120;

              NoNewPrivileges = true;
              PrivateTmp = true;
              ProtectHome = true;
              ProtectSystem = "strict";
            };
          };
        };
      }
    ];
  };
}
