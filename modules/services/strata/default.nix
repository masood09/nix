# Strata — local LLM inference server (OpenAI/Anthropic-compatible API).
#
# Upstream ships a generic-Linux terminal (bundled Python) and a HIP/CUDA
# engine (bundled ROCm/CUDA libraries) through a signed release feed. Nix owns
# the user, directories, FHS runtime, and unit lifecycle; the mutable runtime
# under stateDir is installed and updated by upstream's own signed tooling:
#
#   strata-install   oneshot; runs the official install.sh only when no
#                    terminal is installed (first boot / wiped state)
#   strata           ExecStartPre regenerates upstream's run config with
#                    `strata launch` when the Nix launch options or the
#                    installed terminal/engine versions change; ExecStart then
#                    runs the foreground `strata serve`
#
# Upstream's run config embeds version-specific paths, so it is generated by
# `strata launch` rather than templated here.
{
  config,
  lib,
  pkgs,
  ...
}: let
  homelabCfg = config.homelab;
  cfg = homelabCfg.services.strata;
  caddyEnabled = homelabCfg.services.caddy.enable;
  upstream = "${cfg.listenAddress}:${toString cfg.listenPort}";

  # OpenAI-style error body Caddy returns while Strata is stopped, restarting,
  # or still loading the model, instead of a bare 502.
  unavailableBody = builtins.toJSON {
    error = {
      type = "strata_unavailable";
      code = "backend_unavailable";
      message = "Local inference on ixian is temporarily unavailable (stopped, restarting, or loading the model). Retry shortly.";
    };
  };

  persistenceHelpers = import ../../../lib/persistence-helpers.nix {inherit lib;};
  systemdHelpers = import ../../../lib/systemd-helpers.nix {inherit lib pkgs;};
  permSvc = systemdHelpers.mkPermissionService {
    name = "strata";
    dataDir = cfg.stateDir;
    user = "strata";
    group = "strata";
    mode = "0750";
    mainServices = ["strata" "strata-install"];
  };

  strataBin = "${cfg.stateDir}/.local/bin/strata";
  runConfig = "${cfg.stateDir}/run-config.json";
  configStamp = "${cfg.stateDir}/run-config.stamp";

  # The terminal's bundled Python and the engine need only glibc, the GCC
  # runtime libraries, and zlib from the host (engine SYSTEM-LIBS.txt). The
  # remaining packages are what install.sh shells out to. GPU access comes
  # from the host's /dev, /sys, and /run/opengl-driver, which bubblewrap
  # binds through. The PID namespace stays shared (the nixpkgs default) so
  # systemd's stop signal reaches the server and engine processes directly.
  strataFhs = pkgs.buildFHSEnv {
    name = "strata-fhs";
    targetPkgs = p:
      with p; [
        cacert
        curl
        libdrm
        pciutils
        stdenv.cc.cc.lib
        zlib
      ];
    runScript = pkgs.writeShellScript "strata-fhs-exec" ''
      exec "$@"
    '';
  };

  launchArgs =
    [
      "--family"
      cfg.family
      "--model"
      cfg.model
      "--context"
      cfg.context
      "--vision"
      cfg.vision
      "--mtp"
      (
        if cfg.mtp
        then "on"
        else "off"
      )
      "--data-dir"
      cfg.dataDir
      "--access"
      "local"
      "--port"
      (toString cfg.listenPort)
      "--tune"
      "skip"
    ]
    ++ cfg.extraLaunchArgs;
  launchArgsStr = lib.escapeShellArgs launchArgs;

  strataEnv = {
    HOME = cfg.stateDir;
  };

  configure = pkgs.writeShellScript "strata-configure" ''
    set -euo pipefail
    strata() {
      ${strataFhs}/bin/strata-fhs ${strataBin} "$@"
    }

    # Regenerate when the launch options, the terminal, or the engine set
    # change: the run config names version-specific terminal/engine paths.
    terminal="$(readlink -f ${cfg.stateDir}/.local/share/strata/terminal/current || true)"
    engines="$(ls ${cfg.stateDir}/.local/share/strata/components/engine 2>/dev/null || true)"
    want="$(printf '%s\n' ${lib.escapeShellArg launchArgsStr} "$terminal" "$engines" | ${pkgs.coreutils}/bin/sha256sum)"

    if [ -e ${runConfig} ] && [ "$(cat ${configStamp} 2>/dev/null)" = "$want" ]; then
      exit 0
    fi

    echo "strata: generating run config: strata launch ${launchArgsStr}"
    profile="$(strata launch ${launchArgsStr} --plan --output json | ${pkgs.jq}/bin/jq -r .plan.profile)"

    # `launch` has no write-config-only mode, so it does a full start (one
    # model load), and the owned runtime is stopped before ExecStart serves.
    strata launch ${launchArgsStr} --no-tui --yes --restart
    strata runtime stop --profile "$profile"

    source="$(${pkgs.jq}/bin/jq -r .source_config ${cfg.stateDir}/.config/strata/profiles/"$profile".json)"
    ln -sfn "$source" ${runConfig}

    # Launch wrote the engine version actually used, so stamp after it.
    terminal="$(readlink -f ${cfg.stateDir}/.local/share/strata/terminal/current || true)"
    engines="$(ls ${cfg.stateDir}/.local/share/strata/components/engine 2>/dev/null || true)"
    printf '%s\n' ${lib.escapeShellArg launchArgsStr} "$terminal" "$engines" | ${pkgs.coreutils}/bin/sha256sum > ${configStamp}
  '';

  # Manual CLI: runs upstream's `strata` as the strata user inside the FHS
  # env, e.g. `strata-ctl status`, `strata-ctl update --check`,
  # `strata-ctl components rollback`.
  strataCtl = pkgs.writeShellScriptBin "strata-ctl" ''
    if [ "$(id -u)" != ${toString cfg.userId} ]; then
      exec sudo -u strata -H -- "$0" "$@"
    fi
    cd ${cfg.stateDir}
    exec ${strataFhs}/bin/strata-fhs ${strataBin} "$@"
  '';

  # Polls the TV over network ADB. The TV leaves the network entirely in
  # standby, so only a reachable, `mWakefulness=Awake` TV counts as on;
  # unreachable means off (or unplugged). adb keeps a dead transport as
  # "already connected" after the TV drops off, so every check reconnects.
  tvGuardStateDir = "/var/lib/strata-tv-guard";
  tvGuard = pkgs.writeShellApplication {
    name = "strata-tv-guard";
    runtimeInputs = [
      pkgs.android-tools
      pkgs.coreutils
      pkgs.gnugrep
      pkgs.systemd
    ];
    text = ''
      tv=${lib.escapeShellArg cfg.tvGuard.address}
      # Set only while Strata is down because of the TV, so a manual stop is
      # never undone.
      marker=/run/strata-tv-guard/stopped-by-guard
      off_since=""
      warned_unauthorized=""

      tv_on() {
        adb disconnect "$tv" >/dev/null 2>&1 || true
        timeout 3 adb connect "$tv" >/dev/null 2>&1 || return 1
        if adb devices | grep -q "^''${tv}[[:space:]]*unauthorized"; then
          if [ -z "$warned_unauthorized" ]; then
            echo "TV has not authorized this host's ADB key; accept the prompt on the TV" >&2
            warned_unauthorized=1
          fi
          return 1
        fi
        warned_unauthorized=""
        timeout 5 adb -s "$tv" shell dumpsys power 2>/dev/null | grep -q "mWakefulness=Awake"
      }

      strata_running() {
        case "$(systemctl show -p ActiveState --value strata.service)" in
          active | activating | reloading) return 0 ;;
          *) return 1 ;;
        esac
      }

      while true; do
        if tv_on; then
          off_since=""
          if strata_running; then
            echo "TV is on: stopping Strata"
            touch "$marker"
            systemctl stop strata.service || echo "stopping Strata failed" >&2
          fi
        else
          now=$(date +%s)
          off_since=''${off_since:-$now}
          if [ -e "$marker" ] && [ $((now - off_since)) -ge ${toString cfg.tvGuard.offDelay} ]; then
            echo "TV off for ${toString cfg.tvGuard.offDelay}s: starting Strata"
            rm -f "$marker"
            systemctl start --no-block strata.service
          fi
        fi
        sleep ${toString cfg.tvGuard.interval}
      done
    '';
  };
in {
  imports = [
    ./options.nix
  ];

  config = lib.mkIf cfg.enable {
    users = {
      users = {
        strata = {
          isSystemUser = true;
          group = "strata";
          uid = cfg.userId;
          home = cfg.stateDir;
          createHome = false;
          extraGroups = [
            "render"
            "video"
          ];
        };
      };

      groups = {
        strata = {
          gid = cfg.groupId;
        };
      };
    };

    environment = lib.mkMerge [
      {
        systemPackages = [
          strataCtl
        ];
      }
      (persistenceHelpers.mkPersistenceDirs {
        inherit homelabCfg;
        directories =
          [
            {
              directory = cfg.stateDir;
              user = "strata";
              group = "strata";
              mode = "0750";
            }
          ]
          # The guard's ADB key; losing it means re-authorizing on the TV.
          ++ lib.optionals cfg.tvGuard.enable [
            {
              directory = tvGuardStateDir;
              mode = "0700";
            }
          ];
      })
    ];

    services = {
      caddy = lib.mkIf caddyEnabled {
        virtualHosts = {
          "${cfg.webDomain}" = {
            useACMEHost = config.networking.domain;
            # Strata rejects any Host other than its own (DNS-rebinding
            # protection) and browser Origins it doesn't know. Present the
            # upstream address for both; the Origin is rewritten only for this
            # site's own pages, so other web pages still can't drive the API
            # through a visitor's browser.
            extraConfig = ''
              @selfOrigin header Origin https://${cfg.webDomain}
              request_header @selfOrigin Origin http://${upstream}

              reverse_proxy http://${upstream} {
                header_up Host {upstream_hostport}
                # Stream tokens as they are generated.
                flush_interval -1
              }

              # Only errors Caddy itself raises (upstream refused or timed
              # out) land here; Strata's own error responses pass through.
              # Already-open streams are cut when Strata stops.
              handle_errors 502 503 504 {
                header Content-Type application/json
                header Retry-After 30
                respond `${unavailableBody}` 503
              }
            '';
          };
        };
      };
    };

    systemd = lib.mkMerge [
      permSvc.systemd
      {
        services = {
          # The model tree predates the service user, so hand it over once.
          # Later boots only scan metadata; chown runs only on a mismatch.
          strata-data-permissions = {
            description = "Hand Strata model storage to the strata user";
            before = [
              "strata.service"
            ];
            unitConfig = {
              RequiresMountsFor = [
                cfg.dataDir
              ];
            };
            serviceConfig = {
              Type = "oneshot";
              RemainAfterExit = true;
            };
            script = ''
              install -d -m 0750 -o strata -g strata ${cfg.dataDir}
              if [ "$(stat -c %U ${cfg.dataDir})" != strata ] \
                || [ -n "$(find ${cfg.dataDir} ! -user strata -print -quit)" ]; then
                chown -R strata:strata ${cfg.dataDir}
              fi
              chmod 0750 ${cfg.dataDir}
            '';
          };

          strata-install = {
            description = "Install the Strata terminal from the signed upstream release";
            before = [
              "strata.service"
            ];
            after = [
              "network-online.target"
            ];
            wants = [
              "network-online.target"
            ];
            unitConfig = {
              ConditionPathExists = "!${strataBin}";
            };
            environment = strataEnv;
            path = [
              pkgs.coreutils
              pkgs.curl
            ];
            serviceConfig = {
              Type = "oneshot";
              RemainAfterExit = true;
              User = "strata";
              Group = "strata";
              WorkingDirectory = cfg.stateDir;
            };
            # install.sh checks the terminal archive's SHA-256 against the
            # release manifest and verifies the signed feed with the unpacked
            # terminal before switching `current`.
            script = ''
              work="$(mktemp -d)"
              trap 'rm -rf "$work"' EXIT
              curl -fsSL --retry 3 \
                https://github.com/Niko1221/Strata/releases/latest/download/install.sh \
                -o "$work/install.sh"
              ${strataFhs}/bin/strata-fhs sh "$work/install.sh"
            '';
          };

          strata = {
            description = "Strata local LLM inference server";
            wantedBy = [
              "multi-user.target"
            ];
            after = [
              "network-online.target"
              "strata-install.service"
              "strata-data-permissions.service"
            ];
            wants = [
              "network-online.target"
            ];
            requires = [
              "strata-install.service"
              "strata-data-permissions.service"
            ];
            unitConfig = {
              RequiresMountsFor = [
                cfg.dataDir
              ];
            };
            environment = strataEnv;
            serviceConfig = {
              User = "strata";
              Group = "strata";
              SupplementaryGroups = [
                "render"
                "video"
              ];
              WorkingDirectory = cfg.stateDir;
              RuntimeDirectory = "strata";

              ExecStartPre = configure;
              ExecStart = lib.concatStringsSep " " [
                "${strataFhs}/bin/strata-fhs"
                strataBin
                "serve"
                "--config ${runConfig}"
                "--host ${cfg.listenAddress}"
                "--port ${toString cfg.listenPort}"
                "--parallel 1"
                "--ready-file /run/strata/ready.json"
                "--shutdown-timeout 30"
              ];

              Restart = "on-failure";
              RestartSec = 30;
              # A warm start is 1–3 minutes; a cold first start (engine
              # download, model page-in) was measured at ~16 minutes, and a
              # config regeneration adds one extra model load.
              TimeoutStartSec = "45min";
              # Server drain (--shutdown-timeout) plus engine teardown.
              TimeoutStopSec = 90;

              # Conservative hardening only. Not set: PrivateDevices (HIP needs
              # /dev/kfd and /dev/dri), MemoryDenyWriteExecute (GPU JIT),
              # ProtectKernelTunables (engine reads sysfs), and namespace
              # restrictions (bubblewrap needs a user/mount namespace).
              NoNewPrivileges = true;
              PrivateTmp = true;
              ProtectHome = "tmpfs";
              ProtectSystem = "full";
            };
          };

          strata-tv-guard = lib.mkIf cfg.tvGuard.enable {
            description = "Stop Strata while the TV is on";
            wantedBy = [
              "multi-user.target"
            ];
            after = [
              "network-online.target"
            ];
            wants = [
              "network-online.target"
            ];
            # adb keeps its key in $HOME/.android.
            environment = {
              HOME = tvGuardStateDir;
            };
            serviceConfig = {
              # Root only to stop and start strata.service.
              ExecStart = lib.getExe tvGuard;
              StateDirectory = "strata-tv-guard";
              StateDirectoryMode = "0700";
              RuntimeDirectory = "strata-tv-guard";
              Restart = "always";
              RestartSec = 10;
              # Stopping Strata drains for up to TimeoutStopSec (90 s).
              TimeoutStopSec = 120;

              NoNewPrivileges = true;
              PrivateTmp = true;
              ProtectHome = true;
              ProtectSystem = "strict";
            };
          };
        };
      }
    ];
  };
}
